#!/usr/bin/env sh
# Runs the end-to-end browser tests against a running Almanac server, in the Playwright image.
#   scripts/e2e                                  # http://127.0.0.1:8790/ (scripts/test-server), Chromium
#   scripts/e2e http://127.0.0.1:8790/ firefox   # or webkit
# Start from an empty database: the tests look items up by title.
set -e
cd "$(dirname "$0")/.."
mkdir -p e2e/shots
exec docker run --rm --network host --ipc host \
  -u "$(id -u):$(id -g)" -e HOME=/tmp -e PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
  -v "$PWD/e2e":/work -w /work \
  mcr.microsoft.com/playwright/python:v1.61.0-noble \
  sh -c 'python3 -m pip install -q --break-system-packages --target /tmp/pw playwright==1.61.0 >/dev/null 2>&1 || exit 1
    url="$1"; browser="$2"; shift 2
    files="$*"; [ -n "$files" ] || files="e2e.py"
    status=0
    for f in $files; do echo "=== $f"; PYTHONPATH=/tmp/pw python3 "$f" "$url" "$browser" || status=1; done
    exit $status' -- "${1:-http://127.0.0.1:8790/}" "${2:-chromium}" ${3:-}
