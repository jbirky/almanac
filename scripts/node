#!/usr/bin/env sh
# Runs a command in a Node 22 container with the repo mounted, for hosts
# whose system Node is older than the toolchain needs (Vite, Vitest, better-sqlite3).
#   scripts/node npm install
#   scripts/node npm test
# Set PORTS=1 to publish the dev ports (scripts/dev does this for you).
set -e
cd "$(dirname "$0")/.."
TTY=""
if [ -t 0 ] && [ -t 1 ]; then TTY="-t"; fi
PUBLISH=""
if [ "${PORTS:-0}" = "1" ]; then PUBLISH="-p 127.0.0.1:5173:5173 -p 127.0.0.1:8787:8787"; fi
# Build settings for Vite (VITE_*, as scripts/android/build sets) go along into the container.
VITE_ENV=$(env | sed -n 's/^\(VITE_[A-Za-z0-9_]*\)=.*/-e \1/p' | tr '\n' ' ')
# shellcheck disable=SC2086
exec docker run --rm -i $TTY $PUBLISH $VITE_ENV \
  -u "$(id -u):$(id -g)" -e HOME=/tmp \
  -v "$PWD":/app -w /app \
  node:22-alpine "$@"
