<?xml version="1.0" encoding="utf-8"?>
<!-- A task checked off in the Today widget, until the app checks it off too: as widget_task, its
     box filled and its title faint. (Each color comes from the layout, so it follows dark mode.) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/task_check"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:src="@drawable/widget_check_done" />

    <TextView
        android:id="@+id/task_title"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:paddingStart="2dp"
        android:singleLine="true"
        android:textColor="@color/widget_muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/task_date"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="@color/widget_late"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
